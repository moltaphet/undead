# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local and fill in.

# Required from step 2 onward (autopsy, resurrection, séance).
ANTHROPIC_API_KEY=

# Optional but recommended: raises the GitHub API limit from 60 to 5,000 requests/hour.
# Use a fine-grained token with read-only access to PUBLIC repositories and nothing else.
GITHUB_TOKEN=
