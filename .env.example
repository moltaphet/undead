# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local and fill in.

# Required for the autopsy, resurrection and séance. Gemini is the default provider.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash. Keep it a Flash-class model.
# GEMINI_MODEL=

# Optional. Used when the main model is overloaded, rate limited or slow. "none" turns it off.
# GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Optional. gemini (default) or anthropic. To use Claude, set this and ANTHROPIC_API_KEY instead.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Optional but recommended: raises the GitHub API limit from 60 to 5,000 requests/hour.
# Use a fine-grained token with read-only access to PUBLIC repositories and nothing else.
GITHUB_TOKEN=
